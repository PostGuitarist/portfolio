---
import TechIcon from "./TechIcon.astro";

/**
 * The small technology pill shared by the Skills and Experience sections.
 * Styling lives in the `.tag` component class in `src/styles/global.css` so the
 * two sections can never drift apart again.
 */
interface Props {
	name: string;
	class?: string;
}

const { name, class: className } = Astro.props;
---

<li class:list={["tag print:border-none print:bg-transparent print:px-0 print:py-0 print:text-zinc-700", className]}>
	<TechIcon name={name} />
	<span>{name}</span>
</li>
