---
import Section from "@/components/Section.astro";
import { work } from "@/lib/cv";
import ExperienceItem from "./ExperienceItem.astro";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<Section id="experience" title="Experience" class={className}>
	<ul class="flex flex-col">
		{work.map((role, index) => <ExperienceItem {...role} isLast={index === work.length - 1} />)}
	</ul>
</Section>
