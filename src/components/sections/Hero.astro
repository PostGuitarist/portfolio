---
import ContactLinks from "@/components/ContactLinks.astro";
import Section from "@/components/Section.astro";
import WorldMap from "@/icons/WorldMap.astro";
import { basics } from "@/lib/cv";

const { name, label, image, location, profiles, phone, email } = basics;
const { city, region } = location;

const linkedIn = profiles.find(({ network }) => network === "LinkedIn");
const printContact = [email, phone, linkedIn?.url].filter(Boolean).join(" • ");
---

<Section id="hero">
	<div class="flex flex-col-reverse gap-8">
		<div class="info">
			<h1 class="text-gradient text-4xl font-bold tracking-tight print:text-3xl">{name}</h1>
			<p class="text-base font-medium text-skin-muted print:text-lg">{label}</p>

			<p class="location">
				<WorldMap />
				{city}, {region}
			</p>

			<footer class="print-only text-xs">{printContact}</footer>
			<ContactLinks name={name} email={email} phone={phone} profiles={profiles} />
		</div>

		<figure class="avatar no-print">
			<img src={image} alt={`Portrait of ${name}`} width="638" height="696" fetchpriority="high" decoding="async" />
			<div class="crosshair" aria-hidden="true">
				<span class="line line-left"></span>
				<span class="line line-right"></span>
				<span class="line line-top"></span>
				<span class="line line-bottom"></span>
			</div>
		</figure>
	</div>
</Section>

<style>
	.info {
		@apply flex flex-col gap-1 pr-8 print:gap-0 print:pr-0;
	}

	.location {
		@apply flex items-center gap-1.5 pt-1 text-sm text-skin-muted;
	}

	.avatar {
		@apply relative w-fit;
	}

	.avatar img {
		@apply relative aspect-square w-32 rounded-2xl object-cover shadow-card ring-1 ring-skin-border;
	}

	/* Soft accent halo behind the portrait. */
	.avatar::before {
		content: "";
		@apply absolute -inset-3 -z-10 rounded-3xl bg-skin-hue/20 opacity-60 blur-2xl;
	}

	.crosshair {
		@apply pointer-events-none absolute -inset-2;
	}

	.line {
		@apply absolute bg-skin-hue/50;
	}

	.line-left,
	.line-right {
		@apply -inset-y-8 w-px;
		mask-image: linear-gradient(to top, transparent, white 4rem, white calc(100% - 4rem), transparent);
		-webkit-mask-image: linear-gradient(to top, transparent, white 4rem, white calc(100% - 4rem), transparent);
		animation: grow-y 1s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.line-left {
		@apply left-0;
	}

	.line-right {
		@apply right-0;
		animation-delay: 0.1s;
	}

	.line-top,
	.line-bottom {
		@apply -inset-x-8 h-px;
		mask-image: linear-gradient(to left, transparent, white 4rem, white calc(100% - 4rem), transparent);
		-webkit-mask-image: linear-gradient(to left, transparent, white 4rem, white calc(100% - 4rem), transparent);
		animation: grow-x 1s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.line-top {
		@apply top-0;
		animation-delay: 0.05s;
	}

	.line-bottom {
		@apply bottom-0;
		animation-delay: 0.15s;
	}

	@keyframes grow-y {
		from {
			transform: scaleY(0);
			opacity: 0;
		}
		to {
			transform: scaleY(1);
			opacity: 1;
		}
	}

	@keyframes grow-x {
		from {
			transform: scaleX(0);
			opacity: 0;
		}
		to {
			transform: scaleX(1);
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.line {
			animation: none;
		}
	}

	@media (width <= 700px) {
		.info {
			@apply pr-0;
		}
	}
</style>
