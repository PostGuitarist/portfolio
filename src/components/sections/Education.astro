---
import Section from "@/components/Section.astro";
import ResumeEntry from "@/components/ui/ResumeEntry.astro";
import { certificates, education } from "@/lib/cv";
import { formatYearRange, getYear } from "@/lib/dates";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<Section id="education" title="Education" class={className}>
	<ul class="space-y-4 py-1 print:space-y-0">
		{
			education.map(({ institution, startDate, endDate, area, url }) => (
				<ResumeEntry title={institution} subtitle={area} meta={formatYearRange(startDate, endDate)} url={url}>
					<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
						<path d="M22 10v6" />
						<path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
					</svg>
				</ResumeEntry>
			))
		}
	</ul>

	{
		certificates.length > 0 && (
			<>
				<h3 class="pt-2 text-sm font-semibold uppercase tracking-wide text-skin-muted">Certificates</h3>
				<ul class="space-y-4 py-1 print:space-y-0">
					{certificates.map(({ name, date, issuer, url }) => (
						<ResumeEntry title={name} subtitle={issuer} meta={String(getYear(date))} url={url}>
							<svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M15 12h-5" />
								<path d="M15 8h-5" />
								<path d="M19 17V5a2 2 0 0 0-2-2H4" />
								<path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3" />
							</svg>
						</ResumeEntry>
					))}
				</ul>
			</>
		)
	}
</Section>
