---
interface Props {
	name: string;
	icon?: string;
	size?: "sm" | "lg";
}

const { name, icon, size = "lg" } = Astro.props;
const sizeClass = size === "lg" ? "size-32 rounded-[1.75rem] text-5xl" : "size-12 rounded-xl text-xl";
---

{
	icon ? (
		<img class:list={["object-cover shadow-lg", sizeClass]} src={icon} alt={`${name} app icon`} />
	) : (
		<div class:list={["flex items-center justify-center bg-skin-button-accent font-bold text-skin-inverted shadow-lg", sizeClass]} aria-hidden="true">
			{name.charAt(0).toUpperCase()}
		</div>
	)
}
