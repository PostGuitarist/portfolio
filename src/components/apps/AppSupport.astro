---
import AppsLayout from "@/layouts/AppsLayout.astro";
import Section from "@/components/Section.astro";
import AppAside from "@/components/apps/AppAside.astro";
import Mail from "@/icons/Mail.astro";
import Arrow from "@/icons/Arrow.astro";
import { getDocsForApp, splitDocId, formatDate, type App } from "@/lib/apps";
import { basics } from "@cv";

// Served at both /apps/<slug> and /apps/<slug>/support
interface Props {
	app: App;
}

const { app } = Astro.props;
const { name, tagline, description, supportEmail = basics.email } = app.data;
const docs = await getDocsForApp(app.id);
---

<AppsLayout title={`${name} - Support`} description={tagline}>
	<AppAside slot="aside" app={app} />

	{
		description && (
			<Section title="About">
				<p>{description}</p>
			</Section>
		)
	}

	<Section title="Support">
		<p>Questions, feedback, or found a bug? Send an email and I'll get back to you as soon as I can.</p>
		<a href={`mailto:${supportEmail}?subject=${encodeURIComponent(`${name} Support`)}`} class="inline-flex w-fit items-center gap-2 rounded-md bg-skin-button-muted/50 px-3 py-2 text-sm text-skin-hue ring-1 ring-skin-muted transition hover:bg-skin-button-accent hover:text-skin-inverted">
			<Mail />
			{supportEmail}
		</a>
	</Section>

	{
		docs.length > 0 && (
			<Section title="Legal">
				<div class="grid grid-cols-1 gap-3 md:grid-cols-2">
					{docs.map(({ id, data }) => (
						<a href={`/apps/${app.id}/${splitDocId(id).doc}`} class="group flex flex-col gap-2 rounded-md bg-skin-button-muted/50 p-5 shadow-sm ring-1 ring-skin-muted transition hover:ring-skin-hue">
							<span class="flex items-center gap-[6px] text-lg text-skin-base decoration-dotted underline-offset-[5px] group-hover:text-skin-hue group-hover:underline">
								{data.title}
								<span class="text-skin-hue transition ease-linear group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
									<Arrow />
								</span>
							</span>
							{data.description && <p>{data.description}</p>}
							<p class="!text-xs">Last updated {formatDate(data.lastUpdated)}</p>
						</a>
					))}
				</div>
			</Section>
		)
	}
</AppsLayout>
