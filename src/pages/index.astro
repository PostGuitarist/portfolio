---
import CommandPalette from "@/components/CommandPalette.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";
import About from "@/components/sections/About.astro";
import Education from "@/components/sections/Education.astro";
import Experience from "@/components/sections/Experience.astro";
import Footer from "@/components/sections/Footer.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";
import Layout from "@/layouts/Layout.astro";
import { basics } from "@/lib/cv";

const { name, label } = basics;
---

<Layout title={`${name} Portfolio - ${label}`}>
	<main id="main" class="relative mx-auto grid w-full max-w-7xl gap-12 p-8 max-sm:py-16 md:grid-cols-6 md:p-16 xl:gap-24 print:max-w-none print:grid-cols-1 print:gap-6">
		<div class="sidebar space-y-6 md:col-span-2 print:col-span-1 print:grid print:grid-cols-2 print:gap-5 print:space-y-0">
			<Hero />
			<About />
			<ThemeSwitch />
		</div>

		<div class="space-y-12 md:col-span-4 print:col-span-1 print:grid print:grid-cols-4 print:gap-2 print:space-y-0">
			<Experience class="print:col-span-3" />
			<Projects class="print:hidden" />
			<Skills class="print:hidden" />
			<Education class="print:order-first" />
		</div>

		<Footer />
	</main>

	<CommandPalette />
</Layout>

<style>
	@page {
		size: auto;
		margin: 0mm;
	}

	/*
	 * Keep the identity column in view while the longer right-hand column
	 * scrolls — but only when the viewport is tall enough that the whole sidebar
	 * still fits, otherwise its lower half would become unreachable.
	 */
	@media (min-width: 768px) and (min-height: 720px) {
		.sidebar {
			position: sticky;
			top: 3rem;
			align-self: start;
		}
	}

	@media print {
		.sidebar {
			position: static;
		}
	}
</style>
