---
import AppsLayout from "@/layouts/AppsLayout.astro";
import AppAside from "@/components/apps/AppAside.astro";
import { render } from "astro:content";
import { getApps, getDocsForApp, splitDocId, formatDate } from "@/lib/apps";

export const prerender = true;

export async function getStaticPaths() {
	const apps = await getApps();
	const paths = await Promise.all(
		apps.map(async (app) => {
			const docs = await getDocsForApp(app.id);
			return docs.map((doc) => ({
				params: { app: app.id, doc: splitDocId(doc.id).doc },
				props: { app, doc, docs },
			}));
		}),
	);
	return paths.flat();
}

const { app, doc, docs } = Astro.props;
const { Content } = await render(doc);
const { name } = app.data;
---

<AppsLayout title={`${doc.data.title} - ${name}`} description={doc.data.description ?? `${doc.data.title} for ${name}.`}>
	<div slot="aside" class="flex flex-col gap-8">
		<AppAside app={app} />
		<nav class="flex flex-col gap-1 text-sm" aria-label={`${name} pages`}>
			<a href={`/apps/${app.id}`} class="text-skin-muted transition hover:text-skin-hue">Support</a>
			{
				docs.map(({ id, data }) => (
					<a href={`/apps/${app.id}/${splitDocId(id).doc}`} class:list={["transition hover:text-skin-hue", id === doc.id ? "text-skin-hue" : "text-skin-muted"]} aria-current={id === doc.id ? "page" : undefined}>
						{data.title}
					</a>
				))
			}
		</nav>
	</div>

	<article class="flex flex-col gap-4">
		<header class="flex flex-col gap-2 pb-4">
			<h3 class="text-3xl">{doc.data.title}</h3>
			<p class="!text-xs">Last updated {formatDate(doc.data.lastUpdated)}</p>
		</header>
		<div class="legal-prose">
			<Content />
		</div>
	</article>
</AppsLayout>

<style>
	.legal-prose {
		@apply flex flex-col gap-4;
	}

	.legal-prose :global(h2) {
		@apply pt-4 text-xl font-semibold;
	}

	.legal-prose :global(h3) {
		@apply pt-2 text-lg font-semibold;
	}

	.legal-prose :global(ul),
	.legal-prose :global(ol) {
		@apply ml-5 space-y-1 text-sm text-skin-muted;
	}

	.legal-prose :global(ul) {
		@apply list-disc;
	}

	.legal-prose :global(ol) {
		@apply list-decimal;
	}

	.legal-prose :global(li) {
		line-height: 1.5;
	}

	.legal-prose :global(a) {
		@apply text-skin-hue underline decoration-dotted underline-offset-4;
	}

	.legal-prose :global(strong) {
		@apply text-skin-base;
	}

	.legal-prose :global(hr) {
		@apply border-skin-muted;
	}

	.legal-prose :global(table) {
		@apply w-full text-left text-sm text-skin-muted;
	}

	.legal-prose :global(th),
	.legal-prose :global(td) {
		@apply border-b border-skin-muted py-2 pr-4;
	}

	.legal-prose :global(th) {
		@apply text-skin-base;
	}
</style>
