---
import SpeedInsights from "@vercel/speed-insights/astro";

import BackgroundDecoration from "@/components/BackgroundDecoration.astro";
import { basics } from "@/lib/cv";
import "@/styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const { title, description = basics.summary } = Astro.props;
const { image, url, theme = "default", name } = basics;

const GA_MEASUREMENT_ID = "G-K1K1E71L5Q";

// Open Graph requires absolute URLs; the previous markup shipped `content=""`,
// so link previews had no image at all.
const canonical = new URL(Astro.url.pathname, Astro.site ?? url);
const socialImage = new URL(image, Astro.site ?? url);
---

<!doctype html>
<html lang="en" data-theme={theme}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={name} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preload" as="image" href={image} />

		<meta property="og:site_name" content={name} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />

		{
			/*
			Runs before first paint so the saved theme is applied without the flash
			of the wrong palette the deferred module script used to cause. Kept
			deliberately small and dependency-free; the richer logic lives in
			src/lib/theme.ts.
		*/
		}
		<script is:inline>
			(() => {
				try {
					const stored = localStorage.getItem("theme");
					const preference = stored === "light" || stored === "dark" ? stored : "system";
					const dark = preference === "dark" || (preference === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
					document.documentElement.classList.toggle("dark", dark);
					document.documentElement.dataset.themePreference = preference;
				} catch {
					/* Storage blocked — fall back to the light palette. */
				}
			})();
		</script>

		<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
		<script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());
			gtag("config", GA_MEASUREMENT_ID);
		</script>

		<SpeedInsights />
	</head>
	<body class="relative min-h-screen bg-skin-fill text-skin-base">
		<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-skin-surface focus:px-4 focus:py-2 focus:text-sm focus:shadow-card">
			Skip to content
		</a>

		<BackgroundDecoration />
		<slot />

		<script>
			import { applyPreference, getStoredPreference, watchSystemTheme } from "@/lib/theme";

			const root = document.documentElement;

			// Follow the OS while the preference is "system".
			watchSystemTheme(() => {
				if (getStoredPreference() === "system") applyPreference("system");
			});

			// Reveal-on-scroll. The `reveal-ready` class is only added once JS runs,
			// so content is never hidden from crawlers or no-JS visitors.
			const reveals = document.querySelectorAll<HTMLElement>(".reveal");
			if (reveals.length > 0 && "IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				root.classList.add("reveal-ready");

				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add("is-visible");
							observer.unobserve(entry.target);
						}
					},
					{ rootMargin: "0px 0px -8% 0px", threshold: 0.06 },
				);

				reveals.forEach((element, index) => {
					element.style.setProperty("--reveal-delay", `${Math.min(index, 5) * 70}ms`);
					observer.observe(element);
				});
			}

			// Printing always uses the light palette, and every collapsed entry is
			// expanded so the printed résumé is complete.
			const expandedForPrint: HTMLDetailsElement[] = [];

			window.addEventListener("beforeprint", () => {
				root.classList.remove("dark");
				document.querySelectorAll<HTMLDetailsElement>("details:not([open])").forEach((details) => {
					expandedForPrint.push(details);
					details.open = true;
				});
			});

			window.addEventListener("afterprint", () => {
				applyPreference(getStoredPreference());
				expandedForPrint.splice(0).forEach((details) => {
					details.open = false;
				});
			});
		</script>
	</body>
</html>
