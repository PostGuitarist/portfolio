{
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 200,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.astro",
			"options": { "parser": "astro" }
		},
		{
			"files": ["*.json", "*.md", "*.yml", "*.yaml"],
			"options": { "useTabs": false }
		}
	]
}
